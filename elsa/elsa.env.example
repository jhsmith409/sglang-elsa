# Copy to elsa/elsa.env (or point ELSA_ENV at your copy) and edit.

# Local checkpoint directory of nvidia/Qwen3.6-35B-A3B-NVFP4 (needs hf_quant_config.json).
MODEL_PATH=/path/to/Qwen3.6-35B-A3B-NVFP4

# uv-built environment (see build-venv.sh). Defaults to <repo>/.venv.
# VENV=/path/to/.venv

GPU=0
HOST=0.0.0.0
PORT=8005
SERVED_MODEL_NAME=qwen3.6-moe-nvfp4

# Default for requests that do not set chat_template_kwargs.enable_thinking.
ENABLE_THINKING=false

# Durable compiler caches (FlashInfer / Triton / SGLang JIT). First start compiles
# SM120 kernels for several minutes; later starts reuse them.
# CACHE_DIR=$HOME/.cache/elsa
